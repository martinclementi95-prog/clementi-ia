# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email destinataire (toi) qui reçoit les leads
CONTACT_EMAIL=hello@clementi-ia.fr

# Email expéditeur configuré dans Resend (doit appartenir à un domaine vérifié)
